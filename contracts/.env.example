DEPLOYER_ADDRESS=<0xYOUR_ADDRESS>
# Deployer private key — the account that will pay deployment gas on blockchain.
PRIVATE_KEY=<0xYOUR_PRIVATE_KEY_HERE>

# RPC endpoint for Sepolia/tBNB smart chain
RPC_URL=<YOUR_RPC_URL>

# The block explorer API key for contract verification.
BLOCK_EXPLORER_API_KEY=<YOUR_BLOCK_EXPLORER_API_KEY>

# Set to "true" to print a gas report after each test run.
REPORT_GAS=false

### Script Samples
# getBalance, viewSessions
PARTY_ADDRESS=<0xANY_ADDRESS>
# createSession, claimRefund, transferBalance.ts
CALLER_KEY=<0xYOUR_CALLER_PRIVATE_KEY>
CALLEE_ADDRESS=<0xYOUR_CALLEE_ADDRESS>
REFUND_SESSION_ID=0     # Just for claimRefund
AMOUNT=0                # Just for transferBalance

## resolveDispute.ts 
DISPUTE_WINNER=callee  #Options: caller,callee
DISPUTE_SESSION_ID=0