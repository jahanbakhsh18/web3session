DEPLOYER_ADDRESS=0xYOUR_ADDRESS
# Deployer private key — the account that will pay deployment gas on Sepolia.
# NEVER commit a real key. Use a dedicated testnet-only wallet.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Infura (or Alchemy) endpoint for Sepolia.
# Get one free at https://app.infura.io or https://www.alchemy.com
INFURA_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Etherscan API key for contract verification.
# Get one free at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Set to "true" to print a gas report after each test run.
REPORT_GAS=false



### Script Samples
# getBalance, viewSessions
PARTY_ADDRESS=0x<ANY_ADDRESS>
# createSession
CALLER_KEY=0x<YOUR_CALLER_PRIVATE_KEY>
CALLEE_ADDRESS=0x<YOUR_CALLEE_ADDRESS>
# claimRefund
CALLER_ADDRESS=0x<YOUR_CALLER_ADDRESS>
REFUND_ID=0

