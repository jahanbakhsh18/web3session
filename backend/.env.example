# Server
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgres://web3session:web3session_dev@localhost:5432/web3session

# Chain — used by the event indexer to listen for SessionRegistry events
RPC_URL=<YOUR_RPC_URL>

# Fill YOUR_SESSION_REGISTRY_ADDRESS
SESSION_REGISTRY_ADDRESS=0xD156BfbB380E2Ca2870af6F269B87ce035430aAE

INDEXER_CHUNK_SIZE=40

# Block to start indexing from (the registry's deployment block — saves time vs. scanning from genesis). 
# Find this on the block explorer: contract creation tx.
INDEXER_START_BLOCK=118095005

# How often (ms) the indexer polls for new events. 
INDEXER_POLL_INTERVAL_MS=8000